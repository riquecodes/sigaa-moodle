{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Sigaa": {
    "BaseUrl": "https://dev8e.ifrs.edu.br/api/v1/",
    "TokenUrl": "https://dev8e.ifrs.edu.br/oauth/token",
    "ClientId": "",
    "ClientSecret": "",
    "Scope": "view-sigaa",
    "Unidade": null,
    "PeriodoLetivo": "",
    "PageSize": 100,
    "MaxPages": 10000,
    "Routes": {
      "Alunos": "sig/sigaa/alunos/paginate",
      "Matriculas": "sig/sigaa/matriculados",
      "Cursos": "sig/sigaa/cursos",
      "Notas": "sig/sigaa/alunos/desempenho"
    }
  },
  "InternalApp": {
    "BaseUrl": "",
    "StudentUserType": null,
    "CourseMap": {},
    "Routes": { "Alunos": "api/User", "Matriculas": "", "Cursos": "api/Course", "Notas": "" }
  },
  "Sync": {
    "Cron": "0 0 3 * * *",
    "TimeZone": "America/Sao_Paulo",
